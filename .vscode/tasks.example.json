{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "R5: start GPT pick-place debugger from WSL",
            "type": "process",
            "command": "/init",
            "args": [
                "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "D:\\path\\to\\GPT_Benchmark\\tools\\run_r5_check.ps1",
                "-Debugger",
                "-DebugHost",
                "WINDOWS_WSL_HOST",
                "-Gui",
                "-Check",
                "gpt-pick-place"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "r5-debug",
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): (error|warning): (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^R5_DEBUG_STARTING$",
                    "endsPattern": "^R5_DEBUG_READY "
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
