            }
        }

        def Material "InternalVane2Pigment"
        {
            token outputs:surface.connect = </Asset/Looks/InternalVane2Pigment/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.02, 0.006)
                float inputs:metallic = 0
                float inputs:roughness = 0.19
                token outputs:surface
            }
        }

        def Material "AirBubble"
        {
            token outputs:mdl:surface.connect = </Asset/Looks/AirBubble/Refractive.outputs:out>
            token outputs:surface.connect = </Asset/Looks/AirBubble/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.97, 0.95)
                float inputs:metallic = 0
                float inputs:roughness = 0.01
                token outputs:surface
            }

            def Shader "Refractive"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 1
                color3f inputs:glass_color = (1, 1, 1)
                float inputs:glass_ior = 1
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }
