    def Xform "Colliders"
    {
        def Sphere "Sphere" (
            apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI", "PhysxCollisionAPI"]
        )
        {
            rel material:binding:physics = </Asset/Looks/Contact>
            bool physics:collisionEnabled = 1
            float physxCollision:contactOffset = 0.00008
            float physxCollision:restOffset = 0
            double radius = 0.008
            token visibility = "invisible"
        }
    }

    def Xform "Frames"
    {
    }

    def "Looks"
    {
        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.22
            float physics:restitution = 0.55
            float physics:staticFriction = 0.3
        }

        def Material "Glass"
        {
            token outputs:mdl:surface.connect = </Asset/Looks/Glass/Refractive.outputs:out>
            token outputs:surface.connect = </Asset/Looks/Glass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.88, 0.97, 0.94)
                float inputs:ior = 1.52
                float inputs:metallic = 0
                float inputs:opacity = 0.2
                float inputs:roughness = 0.025
                token outputs:surface
            }

            def Shader "Refractive"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0.016
                float inputs:frosting_roughness = 0.018
                color3f inputs:glass_color = (0.88, 0.97, 0.94)
                float inputs:glass_ior = 1.52
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }

        def Material "InternalVane0Pigment"
        {
            token outputs:surface.connect = </Asset/Looks/InternalVane0Pigment/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.026, 0.008)
                float inputs:metallic = 0
                float inputs:roughness = 0.19
                token outputs:surface
            }
        }

        def Material "InternalVane1Pigment"
        {
            token outputs:surface.connect = </Asset/Looks/InternalVane1Pigment/Surface.outputs:surface>

