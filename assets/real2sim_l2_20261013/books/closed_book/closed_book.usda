#usda 1.0
(
    defaultPrim = "Asset"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxRigidBodyAPI"]
    customData = {
        string cover_texture_provenance = "AI reconstructed from supplied video; not a scan; back cover inferred"
        string label = "神雕侠侣 闭合书本"
        bool pages_articulated = 0
        string paper_finish = "matte roughness, microfiber normal, subtle resting edge undulation; rigid-body version"
        string physical_provenance_json = '{"width_length": "User photo annotations: 14 cm wide, 22 cm long. Measurement uncertainty not supplied.", "mass": "User photo scale display: 378.9 g. Scale calibration and tare not independently verified.", "thickness": "20 mm provisional estimate, NOT measured. Replace with caliper/ruler measurement and rebuild.", "center_of_mass": "Geometric center; assumes uniform effective density of the closed book.", "inertia": "Uniform cuboid analytical approximation using supplied mass and external dimensions.", "friction_restitution": "Uncalibrated engineering starting values. Contact response also depends on the counterpart material and combine rule.", "geometry": "Closed rigid envelope; no page turning, bending, cover compliance, or surface relief. Cover and page colors only."}'
        bool thickness_is_measured = 0
        string visual_revision = "photo_guided_paperback_v2"
        int visual_sheet_count = 180
    }
    kind = "component"
)
{
    point3f physics:centerOfMass = (0, 0, 0)
    float3 physics:diagonalInertia = (0.00154086, 0.0006315, 0.0021471)
    float physics:mass = 0.3789
    quatf physics:principalAxes = (1, 0, 0, 0)
    bool physics:rigidBodyEnabled = 1
    float physxRigidBody:angularDamping = 0
    bool physxRigidBody:enableCCD = 1
    float physxRigidBody:linearDamping = 0
    int physxRigidBody:solverPositionIterationCount = 16
    int physxRigidBody:solverVelocityIterationCount = 4

    def "Looks"
    {
        def Material "Cover"
        {
            token outputs:surface.connect = </Asset/Looks/Cover/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8549926, 0.8549926, 0.80695224)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Paper"
        {
            token outputs:surface.connect = </Asset/Looks/Paper/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8307699, 0.80695224, 0.70837575)
                float inputs:roughness = 0.85
                token outputs:surface
            }
        }

        def Material "Contact" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:restitution = 0.02
            float physics:staticFriction = 0.4
            token physxMaterial:frictionCombineMode = "average"
            token physxMaterial:restitutionCombineMode = "average"
        }

        def Material "PrintedCover"
        {
            token outputs:surface.connect = </Asset/Looks/PrintedCover/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.88, 0.88, 0.86)
                color3f inputs:diffuseColor.connect = </Asset/Looks/PrintedCover/Albedo.outputs:rgb>
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PrintedCover/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.86
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Albedo"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/cover_albedo.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/PrintedCover/UV.outputs:result>
                token inputs:wrapS = "clamp"
                token inputs:wrapT = "clamp"
                float3 outputs:rgb
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PrintedCover/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "PaperTone0"
        {
            token outputs:surface.connect = </Asset/Looks/PaperTone0/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.806, 0.796, 0.761)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PaperTone0/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.96
                token outputs:surface
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PaperTone0/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "PaperTone1"
        {
            token outputs:surface.connect = </Asset/Looks/PaperTone1/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.813, 0.803, 0.768)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PaperTone1/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.96
                token outputs:surface
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PaperTone1/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "PaperTone2"
        {
            token outputs:surface.connect = </Asset/Looks/PaperTone2/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.82, 0.81, 0.775)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PaperTone2/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.96
                token outputs:surface
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PaperTone2/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "PaperTone3"
        {
            token outputs:surface.connect = </Asset/Looks/PaperTone3/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.827, 0.817, 0.782)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PaperTone3/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.96
                token outputs:surface
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PaperTone3/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "PaperTone4"
        {
            token outputs:surface.connect = </Asset/Looks/PaperTone4/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                color3f inputs:diffuseColor = (0.834, 0.824, 0.789)
                float inputs:ior = 1.45
                float inputs:metallic = 0
                normal3f inputs:normal.connect = </Asset/Looks/PaperTone4/FiberNormal.outputs:rgb>
                float inputs:roughness = 0.96
                token outputs:surface
            }

            def Shader "FiberUV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "paperUV"
                float2 outputs:result
            }

            def Shader "FiberNormal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-0.12, -0.12, -1, 0)
                asset inputs:file = @./textures/paper_fiber_normal.png@
                float4 inputs:scale = (0.24, 0.24, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Asset/Looks/PaperTone4/FiberUV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }
    }

    def Xform "Colliders"
    {
        def Cube "Envelope" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </Asset/Looks/Contact>
            bool physics:collisionEnabled = 1
            float physxCollision:contactOffset = 0.0002
            float physxCollision:restOffset = 0
            double size = 1
            token visibility = "invisible"
            float3 xformOp:scale = (0.14, 0.22, 0.02)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "Visuals"
    {
        def Mesh "FrontCover" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform bool doubleSided = 1
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 