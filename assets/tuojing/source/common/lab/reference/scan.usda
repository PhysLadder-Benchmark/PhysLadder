    }

    def Scope "materials"
    {
        def Material "material"
        {
            token outputs:surface.connect = </object/materials/material/surfaceshader.outputs:surface>
            string inputs:diffuseColorTexture:varname = "st"

            def Shader "surfaceshader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.18, 0.18, 0.18)
                color3f inputs:diffuseColor.connect = </object/materials/material/diffuseColorTexture.outputs:rgb>
                float inputs:metallic = 1
                float inputs:roughness = 1
                float inputs:opacity = 1
                token outputs:surface
                token outputs:displacement
            }

            def Shader "diffuseColorTexture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/c022f31f990f252970d1e6358aa36dad_color.jpg@
                texCoord2f inputs:st = (0, 0)
                texCoord2f inputs:st.connect = </object/materials/material/diffuseColorTexture_place2dTexture.outputs:result>
                token inputs:wrapT = "repeat"
                token inputs:wrapS = "repeat"
                float3 outputs:rgb
            }

            def Shader "diffuseColorTexture_place2dTexture"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "st"
                float2 outputs:result
            }
        }
    }
}
