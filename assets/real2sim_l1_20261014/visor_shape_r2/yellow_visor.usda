                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./cloth.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/Fabric/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Printed"
        {
            token outputs:surface.connect = </Asset/Looks/Printed/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 0.68, 0.01)
                color3f inputs:diffuseColor.connect = </Asset/Looks/Printed/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.84
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./band.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/Printed/UV.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float3 outputs:rgb
            }
        }

        def Material "Red"
        {
            token outputs:surface.connect = </Asset/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.32, 0.012, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.83
                token outputs:surface
            }
        }

        def Material "Thread"
        {
            token outputs:surface.connect = </Asset/Looks/Thread/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.57, 0.37, 0.009)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Inner"
        {
            token outputs:surface.connect = </Asset/Looks/Inner/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76, 0.51, 0.025)
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }
    }
}

